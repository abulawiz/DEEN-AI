# ============================================================
# DEEN AI — Environment Configuration
# Copy this file to .env and fill in your Supabase credentials
# ============================================================

# Required for live Supabase PostgreSQL & Auth backend
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional client-side AI fallback keys (prefer setting OPENAI_API_KEY
# or GEMINI_API_KEY inside Supabase Edge Function secrets instead)
# VITE_OPENAI_API_KEY=
# VITE_GEMINI_API_KEY=
